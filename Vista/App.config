<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Cambie Data Source si usa otra instancia de SQL Server -->
    <add name="Veterinaria"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=Veterinaria;Integrated Security=true;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
